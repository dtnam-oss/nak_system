# Google Apps Script API URL
# Get this URL from: Deploy → Manage deployments in Google Apps Script Editor
NEXT_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# API Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Group Chat ID (with minus sign for group/supergroup)
# Use @userinfobot to get chat ID
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Telegram Webhook URL (your deployed app URL + /api/telegram/webhook)
TELEGRAM_WEBHOOK_URL=https://your-app.vercel.app/api/telegram/webhook

# Telegram Topic IDs (get from topic URL in Telegram)
# Example: https://t.me/c/2957881731/169 -> topic ID is 169
TELEGRAM_TOPIC_KET_QUA_XU_LY=169
TELEGRAM_TOPIC_DOI_TAC=0
TELEGRAM_TOPIC_KHACH_HANG=0

# Feature flags
TELEGRAM_ENABLE_LLM=false
TELEGRAM_ENABLE_VOICE=false
TELEGRAM_ENABLE_CHARTS=true

# Anthropic API Key (for LLM features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application URL (for API calls from bot)
NEXT_PUBLIC_API_URL=http://localhost:3000
