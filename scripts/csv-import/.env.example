# Database Configuration
# Copy this file to .env and fill in your database URL

# PostgreSQL Database URL
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/nak_logistics

# Or use Vercel Postgres URL
# POSTGRES_URL=postgres://...

# Alternative: Vercel Postgres (auto-detected)
# The script will use DATABASE_URL or POSTGRES_URL from environment
