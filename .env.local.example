# Copy this file to .env.local and fill in the values

# Database (Already configured in .env)
# POSTGRES_URL=postgresql://user:pass@host:port/dbname

# Google Apps Script Web App URL for sending payslip emails
# No App Password needed - Uses GAS to send emails directly
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Setup Instructions:
# 1. Go to https://script.google.com/
# 2. Create new project, paste code from gas-scripts/send-payslip-email.gs
# 3. Deploy as Web App:
#    - Execute as: Me (your@nakvn.com)
#    - Who has access: Anyone
# 4. Copy the deployment URL
# 5. Paste it above as GAS_WEB_APP_URL
# 6. Restart the dev server: npm run dev

